{
  "name": "entgra-app-publisher-mantine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "tsc -b && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview --host 127.0.0.1",
    "test": "node tests/contracts.test.mjs && node tests/platform-integrations.test.mjs",
    "typecheck": "tsc -b",
    "predev": "node scripts/setup-local.mjs",
    "format": "prettier --write src tests scripts vite.config.ts package.json tsconfig.json index.html",
    "format:check": "prettier --check src tests scripts vite.config.ts package.json tsconfig.json index.html"
  },
  "dependencies": {
    "@mantine/core": "9.8.1",
    "@mantine/hooks": "9.8.1",
    "@mantine/form": "9.8.1",
    "@mantine/dates": "9.8.1",
    "@mantine/notifications": "9.8.1",
    "@mantine/dropzone": "9.8.1",
    "@tabler/icons-react": "^3.34.0",
    "@fontsource/poppins": "^5.2.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "7.18.5",
    "react-router-dom": "7.18.5",
    "axios": "^1.13.0",
    "i18next": "^25.5.0",
    "react-i18next": "^15.7.0",
    "dayjs": "^1.11.18",
    "js-md5": "^0.8.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "node": "^24.0.0",
    "prettier": "^3.6.0"
  }
}

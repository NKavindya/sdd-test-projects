{
  "name": "entgra-uem-app-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "webpack serve --mode development",
    "start": "webpack serve --mode development",
    "build_dev": "webpack --mode development",
    "build_prod": "webpack --mode production",
    "lint": "eslint --ext .js,.cjs src tests build webpack.config.js babel.config.js",
    "lintfix": "npm run lint -- --fix",
    "format": "prettier --write src tests build public/conf *.js *.json .eslintrc.json .prettierrc.json",
    "format:check": "prettier --check src tests build public/conf *.js *.json .eslintrc.json .prettierrc.json",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@ant-design/icons": "5.3.0",
    "@entgra-ui/antd": "4.2.0",
    "antd": "5.14.0",
    "axios": "1.6.7",
    "dayjs": "1.11.10",
    "entgra-icons-react": "1.0.0",
    "i18next": "23.8.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-i18next": "14.0.5",
    "react-joyride": "2.7.4",
    "react-router": "6.22.0",
    "react-router-dom": "6.22.0",
    "react-star-ratings": "^2.3.0",
    "react-twemoji": "0.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/eslint-parser": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.23.3",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "6.10.0",
    "eslint": "8.56.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "html-webpack-plugin": "^5.6.0",
    "mini-css-extract-plugin": "2.8.0",
    "prettier": "3.2.5",
    "webpack": "5.90.3",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "5.0.2"
  }
}
